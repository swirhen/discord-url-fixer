[Unit]
Description=Discord URL fixer bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swirhen
WorkingDirectory=/home/swirhen/discord-url-fixer
ExecStart=/home/swirhen/discord-url-fixer/.venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
